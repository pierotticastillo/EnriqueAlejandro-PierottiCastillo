# ============================================================
# PIA-3 — variables de entorno locales
# Copiar a .env (ignorado por Git) y ajustar valores.
# ============================================================

# Proxy de enlace hacia la nube
# (prefijo PIA3_ para no colisionar con las variables del host)
PIA3_HTTP_PROXY=http://enlace:3128
PIA3_HTTPS_PROXY=http://enlace:3128
PIA3_NO_PROXY=broker,sim,localhost,127.0.0.1,postgres

# Zona horaria
TZ=America/Argentina/Buenos_Aires

# PostgreSQL 16 + pgvector
POSTGRES_DB=pia3
POSTGRES_USER=pia3
POSTGRES_PASSWORD=cambiar_en_local
POSTGRES_PORT=55432

# Conexión del sistema a la base
DATABASE_URL=postgresql+psycopg://pia3:cambiar_en_local@postgres:5432/pia3

# Planta simulada
MQTT_HOST=broker
MQTT_PORT=1883
PLANTA_API_URL=http://sim:8100

# Identidad y latido (sistema/estado cada 30 s)
SISTEMA_ID=pia3
LATIDO_INTERVALO_S=30

# Cola de salida: cada cuánto se intenta vaciar lo que quedó esperando
# (eventos, órdenes y avisos). Es el camino de salida de la planta.
COLA_SONDEO_S=5

# Verificación opcional del enlace externo (vacío = no monitoreado)
ENLACE_CHECK_URL=
ENLACE_TIMEOUT_S=3

# Transcripción local (sin nube). El modelo se descarga durante la build.
# El modelo es el de la lista cerrada del curso: `faster-whisper-base`.
ASR_MOTOR=faster-whisper
ASR_MODELO=base
ASR_LOCAL_ONLY=true
ASR_DOWNLOAD_ROOT=/modelos
ASR_HILOS_CPU=2

# Audios y fotos (volumen Docker `datos`)
DATOS_DIR=/datos

# Conversación de tablet
PARTE_MAX_INTENTOS=3

# RAG (Fase 4): índice híbrido en pgvector + modelo local de embeddings.
# En Docker se usa fastembed; el modelo se descarga durante la build.
RAG_MOTOR=pgvector
RAG_EMBEDDER=fastembed
RAG_MODELO=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_CACHE_DIR=/modelos/rag
RAG_PESO_LEXICO=0.8
RAG_MEMORIA_DIAS=90
# Hilos del embedder ONNX. El runtime de ONNX abre un hilo por núcleo si no
# se le dice otra cosa: sobre la cuota de 2 CPU de la planta el indexado del
# manual le roba la CPU al ASR y cada transcripción pasa de 1,5 s a más de
# 30 s. Con un hilo, el indexado (que va en segundo plano) no frena la planta.
RAG_HILOS=1

# ============================================================
# LLM local (Ollama) — modelo de la lista cerrada:
# Qwen2.5-3B-Instruct Q4_K_M. Es un AUXILIAR DE REDACCIÓN:
# escribe la justificación técnica de la orden, no decide. Las
# reglas de aprobación están en código (`src/analisis/aprobacion.py`).
#
# Si LLM_ACTIVO=false (o si Ollama no responde), el sistema sigue
# funcionando con el texto determinista: no depende del modelo.
#
# La planta no tiene GPU y tiene 8 GB: el modelo corre a demanda
# (keep_alive=0, se descarga al terminar), con 2 hilos y un
# contexto de 2048 tokens.
# ============================================================
LLM_ACTIVO=true
OLLAMA_URL=http://host.docker.internal:11434
# En la simulación, el contenedor de la planta está en redes internas y no
# tiene ruta directa al host: la llamada al modelo local sale por el proxy
# del enlace, que es la única salida sancionada. En la PC de planta real el
# Ollama corre en localhost y el proxy va vacío.
OLLAMA_PROXY=http://enlace:3128
OLLAMA_MODELO=qwen2.5:3b-instruct
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_THREAD=2
# Timeout de la llamada. En la simulación el Ollama del host se alcanza por el
# proxy del enlace y cada vuelta paga la carga del modelo (~40 s); la
# redacción va en un hilo aparte, así que no frena la planta.
OLLAMA_TIMEOUT_S=90
OLLAMA_SEED=42
OLLAMA_KEEP_ALIVE=0
# Tarifa del modelo en USD por millón de tokens (entrada y salida). Con el
# modelo local de la planta es 0: no hay nada que facturar. Si algún día el
# agente usa un modelo de nube, se pone la tarifa y el costo de cada paso sale
# de los tokens medidos.
PRECIO_USD_POR_MILLON=0

# ============================================================
# Núcleo de agentes (LangChain) y presupuesto
#
# El agente consulta las mismas tools del MCP y propone con citas; la
# decisión sigue en código. El presupuesto acota los pasos, los tokens y
# el tiempo de cada consulta, y el corte queda escrito en la bitácora.
# ============================================================
# Presupuesto de pasos: cuántas vueltas del modelo por consulta.
AGENTE_MAX_PASOS=6
# Presupuesto de tokens del agente por consulta. Medido con el modelo
# local: el prompt de la consulta lleva ~1.600 tokens y cada vuelta los
# vuelve a mandar; el cierre de la propuesta suma otra vuelta.
AGENTE_MAX_TOKENS=12000
# Timeout de la consulta al agente. Medido en la planta simulada: cada vuelta
# del modelo local tarda entre 60 y 110 s (se descarga de memoria entre
# llamadas) y la consulta completa ronda los 250 s.
AGENTE_TIMEOUT_S=420
# Contexto y salida propios del agente. El redactor escribe un párrafo;
# el agente consulta con herramientas y después cierra la propuesta en un
# esquema, así que necesita más de las dos cosas.
AGENTE_NUM_CTX=4096
AGENTE_MAX_TOKENS_SALIDA=700
# Timeout global por nota: el plazo desde que la nota entra al sistema
# hasta que el parte sale publicado.
NOTA_TIMEOUT_S=180

# ============================================================
# Central de mantenimiento
#
# Es el canal de decisión del planificador para las órdenes pendientes.
# No es una tool: el agente no puede aprobar nada.
# ============================================================
CENTRAL_ACTIVO=true
CENTRAL_HOST=0.0.0.0
CENTRAL_PUERTO=8200

# ============================================================
# Modelo de nube con visión (NVIDIA)
#
# Es un AUXILIAR: describe la foto para que quien revise sepa qué está
# mirando. No decide, no aprueba y nunca afirma que "no hay daño": si no
# puede responder, el resultado queda indeterminado y la foto sigue yendo a
# revisión humana (fail-safe).
#
# La clave va en el `.env` local (ignorado por Git), nunca acá ni en el
# código. Reemplazá `NVIDIA_API_KEY=` por tu clave:
#
#     NVIDIA_API_KEY=nvapi-...
#
# El modelo tiene que ser el de la lista cerrada (`src/modelos_lista.py`): el
# verificador lo comprueba al arrancar y, si no es, no se llama a la nube.
# ============================================================
NVIDIA_API_KEY=
NVIDIA_MODELO=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_URL=https://integrate.api.nvidia.com/v1
# En la simulación la llamada sale por el proxy del enlace (la única salida
# sancionada). En la PC de planta real, vacío.
NVIDIA_PROXY=http://enlace:3128
# El modelo es de razonamiento: con un tope chico se le va todo en
# razonamiento y la respuesta final queda cortada.
NVIDIA_MAX_TOKENS=800
# Timeout corto a propósito: el aviso de seguridad no espera al modelo.
NVIDIA_TIMEOUT_S=8
NVIDIA_TEMPERATURE=0

# Logging
LOG_LEVEL=INFO

# Tests de base de datos (opcional, para pytest local)
TEST_DATABASE_URL=postgresql+psycopg://pia3:cambiar_en_local@localhost:55432/pia3
