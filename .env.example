# ============================================================
# PIA-3 — variables de entorno locales
# Copiar a .env (ignorado por Git) y ajustar valores.
# ============================================================

# Proxy de enlace hacia la nube
# (prefijo PIA3_ para no colisionar con las variables del host)
PIA3_HTTP_PROXY=http://enlace:3128
PIA3_HTTPS_PROXY=http://enlace:3128
PIA3_NO_PROXY=broker,sim,localhost,127.0.0.1,postgres

# Zona horaria
TZ=America/Argentina/Buenos_Aires

# PostgreSQL 16 + pgvector
POSTGRES_DB=pia3
POSTGRES_USER=pia3
POSTGRES_PASSWORD=cambiar_en_local
POSTGRES_PORT=55432

# Conexión del sistema a la base
DATABASE_URL=postgresql+psycopg://pia3:cambiar_en_local@postgres:5432/pia3

# Planta simulada
MQTT_HOST=broker
MQTT_PORT=1883
PLANTA_API_URL=http://sim:8100

# Identidad y latido (sistema/estado cada 30 s)
SISTEMA_ID=pia3
LATIDO_INTERVALO_S=30

# Verificación opcional del enlace externo (vacío = no monitoreado)
ENLACE_CHECK_URL=
ENLACE_TIMEOUT_S=3

# Transcripción local (sin nube). El modelo se descarga durante la build.
ASR_MOTOR=faster-whisper
ASR_MODELO=small
ASR_LOCAL_ONLY=true
ASR_DOWNLOAD_ROOT=/modelos
ASR_HILOS_CPU=2

# Audios y fotos (volumen Docker `datos`)
DATOS_DIR=/datos

# Conversación de tablet
PARTE_MAX_INTENTOS=3

# RAG (Fase 4): índice híbrido en pgvector + modelo local de embeddings.
# En Docker se usa fastembed; el modelo se descarga durante la build.
RAG_MOTOR=pgvector
RAG_EMBEDDER=fastembed
RAG_MODELO=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_CACHE_DIR=/modelos/rag
RAG_PESO_LEXICO=0.8
RAG_MEMORIA_DIAS=90

# Logging
LOG_LEVEL=INFO

# Tests de base de datos (opcional, para pytest local)
TEST_DATABASE_URL=postgresql+psycopg://pia3:cambiar_en_local@localhost:55432/pia3
